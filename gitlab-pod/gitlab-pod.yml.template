apiVersion: v1
kind: Pod
metadata:
  name: gitlab
  annotations:
    io.podman.annotations.userns: keep-id
spec:
  restartPolicy: Never
  networks:
    - name: podman-default-kube-network
  volumes:
    - name: gitlab-config
      hostPath:
        path: /mission-share/podman/containers/gitlab/config
        type: DirectoryOrCreate
    - name: gitlab-data
      hostPath:
        path: /mission-share/podman/containers/gitlab/data
        type: DirectoryOrCreate
    - name: gitlab-logs
      hostPath:
        path: /mission-share/podman/containers/gitlab/logs
        type: DirectoryOrCreate
    - name: resolv-conf
      hostPath:
        path: /mission-share/podman/containers/configs/resolv.conf
        type: File
    - name: ssl
      hostPath:
        path: /mission-share/podman/containers/keys/gitlab
        type: DirectoryOrCreate

  containers:
    - name: gitlab
      image: localhost/gitlab-ce-custom:GITLAB_VERSION
      hostname: GITLAB_DOMAIN
      securityContext:
        runAsUser: 0
        runAsGroup: 0
      resources:
        limits:
          memory: "12560Mi"
      env:
        - name: GITLAB_ROOT_EMAIL
          value: "GITLAB_ADMIN_USERNAME"
        - name: GITLAB_ROOT_PASSWORD
          value: "GITLAB_ADMIN_PW"
        - name: GITLAB_OMNIBUS_CONFIG
          value: |
            external_url 'https://GITLAB_DOMAIN:9443'
            nginx['listen_port'] = 443
            nginx['listen_address'] = ['IP_ADDRESS']
            gitlab_https = true
            nginx['listen_https'] = true
            gitlab_rails['initial_root_password'] = 'GITLAB_ADMIN_PW'
            gitlab_rails['initial_root_email'] = 'GITLAB_ADMIN_USERNAME'

            #container registry stuff
            registry_external_url 'https://GITLAB_DOMAIN:5050'
            #using https results in strange self signed errors
            registry_enable = true
            gitlab_rails['gitlab_default_projects_features_container_registry'] = true

            #ldap stuff
            gitlab_rails['ldap_enabled'] = true
            gitlab_rails['ldap_servers'] = YAML.load <<-'EOS'
              main: # 'main' is the GitLab 'provider ID' of this LDAP server
                label: 'LDAP'
                host: 'LDAP_HOST'
                port: 389
                uid: 'sAMAccountName'
                bind_dn: 'LDAP_BIND_DN'
                password: 'LDAP_PASSWORD'
                encryption: 'plain' # "start_tls" or "simple_tls" or "plain"
                verify_certificates: true
                smartcard_auth: false
                active_directory: true
                smartcard_ad_cert_field: 'altSecurityIdentities'
                smartcard_ad_cert_format: null # 'issuer_and_serial_number', 'issuer_and_subject' , 'principal_name'
                allow_username_or_email_login: false
                lowercase_usernames: true
                block_auto_created_users: false
                base: 'LDAP_BASE'
                #requires paid version
                #admin_group: 'Workstation Admins'
                user_filter: ''
              EOS

      volumeMounts:
        - name: gitlab-config
          mountPath: /etc/gitlab:Z
        - name: gitlab-data
          mountPath: /var/opt/gitlab:Z
        - name: gitlab-logs
          mountPath: /var/log/gitlab:Z
        - name: ssl
          mountPath: /etc/gitlab/ssl:Z
        - name: resolv-conf
          mountPath: /etc/resolv.conf
      ports:
        - containerPort: 443
          hostPort: 9443
        - containerPort: 80
          hostPort: 8088
        - containerPort: 22
          hostPort: 2200
        - containerPort: 5050
          hostPort: 5050

